Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Ninja App Maker
Bundle-SymbolicName: org.red1.ninja2;singleton:=true
Bundle-Version: 11.0.0.qualifier
Require-Bundle: org.adempiere.base;bundle-version="11.0.0",
 org.eclipse.jetty.util,
 org.adempiere.install;bundle-version="11.0.0"
Bundle-RequiredExecutionEnvironment: JavaSE-17
Require-Capability: osgi.ee;filter:="(&(osgi.ee=JavaSE)(version>=11))"
Import-Package: org.eclipse.equinox.app,
 org.osgi.framework,
 org.osgi.framework.launch;version="[1.2.0,2.0.0)"
Bundle-ActivationPolicy: lazy
Bundle-Activator: org.adempiere.install.InstallBundleActivator
Bundle-ClassPath: .,
 lib/commons-math3.jar,
 lib/poi.jar
Automatic-Module-Name: org.adempiere.install
Bundle-Vendor: RED1 D. OON
